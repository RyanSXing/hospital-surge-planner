# Local development. `make setup` generates unique secrets in the untracked .env.
APP_ENV=development
DEMO_MODE=true
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///data/hospital.db
REDIS_URL=
ARTIFACT_BACKEND=local
ARTIFACT_LOCAL_DIR=data/artifacts
ADMIN_PASSWORD=GENERATE_ON_SETUP
SESSION_SECRET=GENERATE_ON_SETUP
POSTGRES_PASSWORD=GENERATE_ON_SETUP
POSTGRES_DB=hospital
POSTGRES_USER=hospital
MAX_HORIZON_DAYS=365
DEFAULT_REPLICATIONS=100
MAX_REPLICATIONS=500
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=1200
MAX_UPLOAD_BYTES=104857600
MAX_QUEUED_RUNS=20
OCI_AUTH=instance_principal
OCI_REGION=us-chicago-1
OCI_NAMESPACE=
OCI_ARTIFACT_BUCKET=
OCI_BACKUP_BUCKET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
FEATURE_CLINIC=true
FEATURE_TRANSFERS=true
FEATURE_REPLAY=true
FEATURE_AI=false
# Set these on the OCI host before enabling the tls Compose profile.
DOMAIN=localhost
DOMAIN_ALIASES=
TLS_EMAIL=
COMPOSE_APP_ENV=production
COMPOSE_ARTIFACT_BACKEND=local
IMAGE_TAG=1.0.0
