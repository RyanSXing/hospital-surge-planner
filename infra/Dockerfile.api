FROM ghcr.io/astral-sh/uv:0.11.28 AS uv
FROM python:3.12.15-alpine3.24
COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /app
ARG CODE_COMMIT=uncommitted-working-tree
ENV CODE_COMMIT=${CODE_COMMIT}
LABEL org.opencontainers.image.revision=${CODE_COMMIT}
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/apps/api:/app/packages/engine PATH=/app/.venv/bin:$PATH
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev
COPY apps/api apps/api
COPY packages/engine packages/engine
COPY infra/alembic.ini infra/alembic.ini
COPY infra/migrations infra/migrations
COPY scripts scripts
RUN addgroup -g 10001 -S planner && adduser -u 10001 -S -D -G planner planner && mkdir -p /app/data/artifacts /app/evidence /app/backups && chown -R planner:planner /app/data /app/evidence /app/backups
USER planner
EXPOSE 8000
CMD ["uvicorn", "surge_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
